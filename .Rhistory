library(leaflet)
library(dplyr)
data(quakes)
small <- quakes |> filter(mag < 5)
large <- quakes |> filter(mag >= 5)
leaflet() |>
# Basemaps
addProviderTiles("Esri.WorldGrayCanvas", group = "Light map") |>
addProviderTiles("Esri.WorldImagery", group = "Satellite") |>
addProviderTiles("Esri.OceanBasemap", group = "Ocean") |>
addProviderTiles("Stadia.StamenWatercolor", group = "Artsy") |>
# Small earthquakes
addCircleMarkers(
data = small,
lng = ~long, lat = ~lat,
radius = 3,
color = "blue",
group = "Smaller quakes",
stroke = FALSE,
fillOpacity = 0.5
) |>
# Large earthquakes
addCircleMarkers(
data = large,
lng = ~long, lat = ~lat,
radius = ~mag * 2,
color = "red",
group = "Larger quakes",
stroke = TRUE,
weight = 1
) |>
# Layer control
addLayersControl(
baseGroups = c("Light map", "Satellite", "Artsy"),
overlayGroups = c("Smaller quakes", "Larger quakes"),
options = layersControlOptions(collapsed = FALSE)
)
leaflet() |>
# Basemaps
addProviderTiles("Esri.WorldGrayCanvas", group = "Light map") |>
addProviderTiles("Esri.WorldImagery", group = "Satellite") |>
addProviderTiles("Esri.OceanBasemap", group = "Ocean") |>
#addProviderTiles("Stadia.StamenWatercolor", group = "Artsy") |>
# Small earthquakes
addCircleMarkers(
data = small,
lng = ~long, lat = ~lat,
radius = 3,
color = "blue",
group = "Smaller quakes",
stroke = FALSE,
fillOpacity = 0.5
) |>
# Large earthquakes
addCircleMarkers(
data = large,
lng = ~long, lat = ~lat,
radius = ~mag * 2,
color = "red",
group = "Larger quakes",
stroke = TRUE,
weight = 1
) |>
# Layer control
addLayersControl(
baseGroups = c("Light map", "Satellite", "Artsy"),
overlayGroups = c("Smaller quakes", "Larger quakes"),
options = layersControlOptions(collapsed = FALSE)
)
leaflet() |>
# Basemaps
addProviderTiles("Esri.WorldGrayCanvas", group = "Light map") |>
addProviderTiles("Esri.WorldImagery", group = "Satellite") |>
addProviderTiles("Esri.OceanBasemap", group = "Ocean") |>
addProviderTiles("Stadia.StamenWatercolor", group = "Artsy") |>
# Small earthquakes
addCircleMarkers(
data = small,
lng = ~long, lat = ~lat,
radius = 3,
color = "blue",
group = "Smaller quakes",
stroke = FALSE,
fillOpacity = 0.5
) |>
# Large earthquakes
addCircleMarkers(
