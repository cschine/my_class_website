# this is code to create hour and minute columns that you can then use
# for your datetime column in question 1
flights <- flights |>
mutate(dep_hour = dep_time %/%  100) |>  # "500" %/% 100 ---> "5"
mutate(dep_minute = dep_time %% 100)  # "500" %% 100 --> "00"
flights_mod <- flights |>
mutate(date=make_date(year, month, day))
View(flights_mod)
flights_mod <- flights |>
mutate(sched_departure_datetime=make_date(year, month, day, dep_hour, dep_minute))
flights_mod <- flights |>
mutate(sched_departure_datetime=make_datetime(year, month, day, dep_hour, dep_minute))
View(flights_mod)
